<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FolderSuggest.Views.TrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Train Folder Model" Height="250" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <DockPanel Background="#F5F5F5">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Background="#2E5090" Height="80">
            <StackPanel Orientation="Vertical" Margin="15">
                <TextBlock Text="Model Training" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Train the folder prediction model from your email history"
                           Foreground="#D0D0D0" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Bottom status bar -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderThickness="0,1,0,0" BorderBrush="#CCCCCC">
            <TextBlock Margin="15,8" Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="#666666" TextWrapping="Wrap"/>
        </Border>

        <!-- Body -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Start Training button -->
            <Button Grid.Row="0"
                    Command="{Binding StartTrainingCommand}"
                    Background="#2E5090" Foreground="White"
                    Padding="20,10" FontSize="13" Cursor="Hand"
                    HorizontalAlignment="Left" MinWidth="140">
                <TextBlock Text="Start Training" TextAlignment="Center"/>
            </Button>

            <!-- Progress bar -->
            <ProgressBar Grid.Row="2"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         Height="22"/>
        </Grid>

    </DockPanel>
</Window>
